											<ParamRange name="Fallback" T="DOUBLE" default="1000" value="260.0">
												<PhaseSourceStatic name="PhaseSourceStatic" />
											</ParamRange>
										</Params>
									</PhaseSourceFFT>
									<ValueRange name="startStop" min="0.03" max="0.09" />
								</ParamRange>
							</Params>
						</RenderPass>
					</VideoSource>
				</PrimarySource>
			</VideoTrack>
		</Clip>
	</Deck>
	<Notes name="Notes">
		<Note text_size_multiplier="2" text_color_index="4" text="" />
	</Notes>
</Composition>
